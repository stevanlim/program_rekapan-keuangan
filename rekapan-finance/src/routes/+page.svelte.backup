		justify-content: center;
		border: 2px solid #ffffff;
	}

	.bell-badge.danger {
		background: #dc2626;
		animation: pulse 1.5s infinite;
	}

	.bell-badge.warning {
		background: #f59e0b;
	}

	@keyframes pulse {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.15);
		}
	}

